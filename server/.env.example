# ============================================================
# AI Jira Ticket Generator - Environment Configuration
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ──────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────
# Local:   mongodb://localhost:27017/ai_jira_tickets
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_jira_tickets
MONGODB_URI=mongodb://localhost:27017/ai_jira_tickets

# ──────────────────────────────────────────
# JWT Secrets (use strong random strings, min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_long_replace_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_characters_long_replace_this_too

# Token expiry (ms duration strings understood by jsonwebtoken)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ──────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX=100

# ──────────────────────────────────────────
# Logging
# ──────────────────────────────────────────
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
# Option 1: individual fields (local / Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Option 2: URL (Upstash, Redis Cloud, etc.) — overrides host/port when set
# REDIS_URL=redis://:<password>@<host>:<port>

# Cache TTLs in seconds
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=3600

# ──────────────────────────────────────────
# Email (nodemailer)
# ──────────────────────────────────────────
# SMTP provider — use Gmail, Outlook, Mailgun SMTP, etc.
# For Gmail: enable "App Passwords" and use that as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=AI Ticket App <your-email@gmail.com>

# Invite token expiry (hours, default 48)
INVITE_EXPIRES_HOURS=48

# ──────────────────────────────────────────
# Security
# ──────────────────────────────────────────
# bcrypt cost factor (10-12 recommended for production)
BCRYPT_ROUNDS=12
